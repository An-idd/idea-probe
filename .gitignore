# Local configuration, credentials and recovery backups
/.local-backups/
**/.env
**/.env.*
!**/.env.example
/config.json
/config.local.json
**/*.local.json
**/*credentials*.json
**/*secret*.json
!/scripts/secret_scan_allowlist.json
**/*token*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/.netrc
**/*cookie*.json
/.claude/

# Local research results and logs
/data/
/logs/
**/*.log
**/*.jsonl
**/*.sqlite
**/*.sqlite3

# Environments, caches and build output
**/.venv/
**/venv/
**/.python-venv/
**/.conda-env/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/
**/build/
**/dist/
**/.cache/
**/.DS_Store
**/.idea/
**/.vscode/
**/*.swp
